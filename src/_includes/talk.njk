---
layout: base.njk
---
<section class="page-heading talk-heading"><div class="container">
  <a class="back-link" href="{{ '/talks/' | url }}"><span aria-hidden="true">←</span> All talks</a>
  <div class="detail-label"><span class="pill">{{ topic }}</span>{% if example %}<span class="example-label">Illustrative example · Not a confirmed event</span>{% endif %}</div>
  <h1>{{ title }}</h1>
  <p>{{ description }}</p>
  <ul class="meta-chips" aria-label="Seminar summary">
    <li>{% if starts %}<time datetime="{{ starts | iso }}">{{ starts | dateLabel }}</time>{% elif plannedMonth %}{{ plannedMonth | monthLabel }}{% else %}Date to be announced{% endif %}</li>
    {% if starts %}<li>{{ starts | timeLabel }}{% if ends %} – {{ ends | timeLabel }}{% endif %}</li>{% endif %}
    {% if venue %}<li>{{ venue }}</li>{% endif %}
    <li>{{ speaker }}</li>
  </ul>
</div></section>
{% if coverImage %}<div class="container detail-cover"><img class="cover-fit-{{ coverFit or 'cover' }}" src="{{ coverImage | url }}" alt="{{ coverImageAlt or '' }}" width="1200" height="600" fetchpriority="high" decoding="async"></div>{% endif %}
<div class="container detail-grid">
  <article class="prose">
    {{ content | safe }}
    <section class="speaker-bio" aria-labelledby="speaker-heading"><h2 id="speaker-heading">About the speaker</h2>
      <div class="speaker-bio-heading"><img src="{{ (speakerPhoto or '/assets/portrait-placeholder.svg') | url }}" alt="{% if speakerPhoto %}{{ speakerPhotoAlt or speaker }}{% endif %}" width="160" height="160" loading="lazy" decoding="async"><div><h3>{{ speaker }}</h3><p>{{ affiliation }}</p></div></div>
      {% if speakerBio %}<p>{{ speakerBio }}</p>{% else %}<p>A speaker biography will be added when this seminar is confirmed.</p>{% endif %}
      <div class="profile-links">{% if speakerProfile %}<a href="{{ speakerProfile }}" rel="external">Speaker profile ↗</a>{% endif %}{% for link in speakerLinks %}<a href="{{ link.url }}" rel="external">{{ link.label }} ↗</a>{% endfor %}</div>
    </section>
    {% if slides or recording %}<h2>Resources</h2>{% if slides %}<p><a href="{{ slides | url }}">Download slides (PDF) ↗</a></p>{% endif %}{% if recording %}<p><a href="{{ recording }}">Watch the recording ↗</a></p>{% endif %}{% endif %}
  </article>
  <aside class="event-details" aria-label="Seminar details"><span class="eyebrow">Seminar details</span><dl>
    <dt>When</dt><dd>{% if starts %}<time datetime="{{ starts | iso }}">{{ starts | dateLabel }}</time><br>{{ starts | timeLabel }}{% if ends %} – {{ ends | timeLabel }}{% endif %}<br><small>{{ site.timezone }}</small>{% else %}{% if plannedMonth %}{{ plannedMonth | monthLabel }}{% else %}Date to be announced{% endif %}<br><small>Exact date and time to be announced</small>{% endif %}</dd>
    <dt>Speaker</dt><dd>{{ speaker }}<br><small>{{ affiliation }}</small></dd>
    <dt>Where</dt><dd>{{ venue }}{% if meetingUrl %}<a class="zoom-meeting-link" {% if meetingOpens %}data-meeting-url="{{ meetingUrl }}" data-meeting-opens="{{ meetingOpens | iso }}" role="link" aria-disabled="true"{% else %}href="{{ meetingUrl }}"{% endif %} rel="external">{% if meetingLogo %}<img src="{{ meetingLogo | url }}" alt="" width="28" height="28">{% endif %}<span>Join on Zoom ↗</span></a>{% if meetingOpens %}<small class="zoom-availability" data-meeting-notice>Link opens on {{ meetingOpens | dateLabel }} at {{ meetingOpens | timeLabel }} (Helsinki time).</small>{% endif %}{% endif %}</dd>
    <dt>Language</dt><dd>{{ language or 'English' }}</dd></dl>
    {% if not example %}{% if registration %}<a class="button" href="{% if registrationEmbed %}#registration{% else %}{{ registration }}{% endif %}">Register for the workshop <span aria-hidden="true">→</span></a>{% endif %}{% if starts %}<a class="text-link calendar-link" href="{{ ('/calendar/' + page.fileSlug + '.ics') | url }}">Add to calendar <span aria-hidden="true">↓</span></a>{% endif %}{% endif %}
  </aside>
</div>
{% if registration and registrationEmbed and not example %}
<section id="registration" class="container microsoft-contact workshop-registration" aria-labelledby="registration-heading"><div class="section-heading"><div><span class="eyebrow">Join the workshop</span><h2 id="registration-heading">Registration.</h2></div><a class="text-link" href="{{ registration }}" rel="external">Open registration on Microsoft Forms ↗</a></div><p class="microsoft-form-note">Register using the form below. Microsoft Forms collects your response. <a href="{{ '/accessibility/' | url }}">Privacy information</a></p><iframe class="microsoft-form-frame" title="Workshop registration — {{ title }}" src="{{ registration }}&amp;embed=true" width="640" height="780" loading="lazy" allowfullscreen></iframe><p class="microsoft-form-note">If the form does not load, <a href="{{ registration }}" rel="external">open registration directly</a>.</p></section>
{% endif %}
