<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {%- set isHome = page.url == '/' %}
  {%- set pageTitle = site.seoTitle if isHome else ((title or site.name) + ' · ' + site.name + ' seminars') %}
  {%- set pageDescription = description or site.description %}
  {%- set canonical = page.url | url | absolute %}
  {%- set isPost = tags and 'post' in tags %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  {% if noindex %}<meta name="robots" content="noindex,follow">{% else %}<meta name="robots" content="index,follow,max-image-preview:large">{% endif %}
  <meta name="author" content="{{ site.name }} seminars · {{ site.organization.name }}">
  <meta name="theme-color" content="#0B1B2E">
  <meta name="color-scheme" content="light">
  <meta property="og:site_name" content="{{ site.name }} seminars">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ socialImage.url }}">
  <meta property="og:image:alt" content="{{ socialImage.alt }}">
  {% if socialImage.width %}<meta property="og:image:width" content="{{ socialImage.width }}"><meta property="og:image:height" content="{{ socialImage.height }}">{% endif %}
  {% if isPost %}<meta property="article:published_time" content="{{ page.date | iso }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ socialImage.url }}">
  <meta name="twitter:image:alt" content="{{ socialImage.alt }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/assets/apple-touch-icon.png' | url }}">
  <link rel="alternate" type="application/atom+xml" title="LEACS journal" href="{{ '/feed.xml' | url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ site.font.query | safe }}{% if site.displayFont.family != site.font.family %}&family={{ site.displayFont.query | safe }}{% endif %}{% if site.monoFont.family != site.font.family %}&family={{ site.monoFont.query | safe }}{% endif %}&display=swap" rel="stylesheet">
  {% if isHome %}<link rel="preload" as="image" href="{{ '/content/images/cognition-interface.webp' | url }}" type="image/webp" fetchpriority="high">{% endif %}
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/people.css' | url }}">
  <style>:root{--font:'{{ site.font.family }}',system-ui,sans-serif;--font-display:'{{ site.displayFont.family }}',var(--font);--font-mono:'{{ site.monoFont.family }}',ui-monospace,monospace}</style>
  <script src="{{ '/assets/site.js' | url }}" defer></script>
  {% if pageSchema %}<script type="application/ld+json">{{ pageSchema | json | safe }}</script>{% endif %}
</head>
<body{% if isHome %} class="is-home"{% endif %}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" data-header>
    <div class="container header-inner">
      <a class="brand" href="{{ '/' | url }}" aria-label="LEACS seminars — home"><img class="brand-logo" src="{{ '/assets/logo-mark.svg' | url }}" alt="" width="40" height="40"><span class="brand-text">LEACS<span class="brand-sub">Seminar series</span></span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation" hidden><span>Menu</span><span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button>
      <nav id="navigation" aria-label="Main navigation">
        {% for label, link in [['Home','/'], ['About','/about/'], ['Talks','/talks/'], ['Journal','/journal/'], ['Contact','/contact/']] %}
        <a href="{{ link | url }}" {% if page.url == link %}aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
        {% set nextTalk = collections.upcoming[0] %}
        <a class="nav-cta" href="{{ (nextTalk.url if nextTalk else '/talks/') | url }}">{% if nextTalk %}<span class="live-dot" aria-hidden="true"></span>Next talk{% else %}Explore the talks{% endif %} <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-about">
        <a class="brand" href="{{ '/' | url }}"><img class="brand-logo" src="{{ '/assets/logo-mark.svg' | url }}" alt="" width="40" height="40"><span class="brand-text">LEACS<span class="brand-sub">Seminar series</span></span></a>
        <p>An open seminar series where cognitive science meets human–computer interaction.</p>
        <p class="footer-affiliation"><a href="{{ site.organization.departmentUrl }}" rel="external">{{ site.affiliation }}</a></p>
      </div>
      <div class="footer-links"><span class="eyebrow">Explore</span><a href="{{ '/about/' | url }}">About the series</a><a href="{{ '/talks/' | url }}">Talks &amp; recordings</a><a href="{{ '/journal/' | url }}">Journal</a></div>
      <div class="footer-links"><span class="eyebrow">Connect</span><a href="{{ '/contact/' | url }}">Propose a talk</a>{% if site.email %}<a href="mailto:{{ site.email }}">Email the organizers</a>{% endif %}<a href="{{ '/feed.xml' | url }}">RSS feed</a>{% if site.social.github %}<a href="{{ site.social.github }}" rel="external">GitHub</a>{% endif %}{% if site.social.linkedin %}<a href="{{ site.social.linkedin }}" rel="external">LinkedIn</a>{% endif %}</div>
    </div>
    <div class="container footer-bottom"><span>© {{ buildYear }} LEACS seminars</span><span class="mono">cognition × interaction</span><a href="{{ '/accessibility/' | url }}">Accessibility &amp; privacy</a></div>
  </footer>
</body>
</html>
